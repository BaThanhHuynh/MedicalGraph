# ==============================================================================
# MEDKG-HRR SYSTEM CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API (Google Gemini - UI/UX Layer)
# ------------------------------------------------------------------------------
# API Key lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# 2. NEO4J GRAPH DATABASE (Kênh Đồ Thị KG - Schema v2)
# ------------------------------------------------------------------------------
# Cục bộ (Neo4j Desktop / Community):
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Hoặc Neo4j Aura (Cloud):
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_aura_password_here

# ------------------------------------------------------------------------------
# 3. ĐƯỜNG DẪN DỮ LIỆU & MÔ HÌNH (Data Assets & Local Models)
# ------------------------------------------------------------------------------
PHOBERT_MODEL_PATH=models/phobert-medical-contrastive
FAISS_INDEX_PATH=data/faiss_medical_local_phobert.index
CSV_RAG_CHUNKS=data/medical_chunks_hierarchical.csv
CSV_MEDICAL=data/medical_data_cleaned.csv
BGE_RERANKER_PATH=BAAI/bge-reranker-v2-m3

# ------------------------------------------------------------------------------
# 4. SIÊU THAM SỐ MEDKG-HRR (Khớp chuẩn Bài báo v16, Phụ lục D)
# ------------------------------------------------------------------------------
TOP_K=10
RRF_K=60
RERANK_TOP_N=5
BGE_MAX_LENGTH=1024
DENSE_TOPK_PER_VEC=5
BM25_TOP_N=50
KG_SYMP_MAX=6

# Ngưỡng trích xuất triệu chứng
DICT_SIM_THRESHOLD=0.55
DICT_MIN_TOKEN_OVR=1

# Tham số hợp nhất 3 nhánh (Hybrid Fusion v11)
ALPHA_CONSENSUS=0.25
CONSENSUS_BONUS=0.40
KG_HIGH_CONF_THRESHOLD=0.85
KG_MED_CONF_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 5. CỜ BẬT / TẮT THÀNH PHẦN (Component Toggles)
# ------------------------------------------------------------------------------
# Bật/tắt BGE Reranker (Tắt nếu CPU quá tải: false)
USE_BGE_RERANKER=true

# Bật/tắt kênh đồ thị Neo4j (Tự động fallback nếu Neo4j chưa bật)
USE_KG_RETRIEVAL=true
